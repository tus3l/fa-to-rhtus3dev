{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "public",
  "functions": {
    "server.js": {
      "includeFiles": "{config.json,index.html,styles.css,app.js,database/*.crt}",
      "excludeFiles": "{data/**,.env,.env.*,test-results/**,tests/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/sign/:token", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}